# Template for ~/revtr-alerts/alert.env on the revtr-dashboard VM.
#
# Copy to the VM, fill in, chmod 600. NEVER commit the filled-in version --
# this repo is PUBLIC. .gitignore covers alert.env, .env and *.alert_state.json.
#
#   scp this file to the VM, then: chmod 600 ~/revtr-alerts/alert.env
#
# Amazon SES settings shown. Any provider speaking SMTP works: set SMTP_PORT
# and, if it is not 587/STARTTLS or 465/implicit-TLS, SMTP_SECURITY.

# --- Transport -------------------------------------------------------------
# SES SMTP endpoints are PER-REGION and so are verified identities. Use the
# same region you verified the addresses in.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
# starttls (587) | ssl (465) | none. Inferred from SMTP_PORT when blank.
SMTP_SECURITY=

# IMPORTANT: these are SES *SMTP credentials*, NOT your AWS access key ID and
# secret access key. Generate them in the SES console under
# "SMTP settings -> Create SMTP credentials"; that creates an IAM user whose
# password is derived from the secret key. Pasting a raw AWS access key here
# fails authentication.
SMTP_USER=
SMTP_PASSWORD=

# Must be an address verified in SES, in the region above.
SMTP_FROM=

# --- Routing ---------------------------------------------------------------
# While SES is in the sandbox, EVERY RECIPIENT must itself be a verified
# identity -- and an unverified one fails AFTER a successful SMTP 250, so it
# looks like it worked. "Sending only to yourself" is NOT sufficient if your
# address is on a different domain than the one you verified: 16 alerts to
# loqman@measurementlab.net were accepted and dropped over 8 days.
#
# Safest choice is an address on the verified domain, forwarded onward by
# whatever hosts its MX (Cloudflare Email Routing here). That stays inside the
# sandbox and gives you a delivery audit trail for free.
ALERT_EMAIL_TO=alerts@hermes-dashboard.org

# --- Behaviour -------------------------------------------------------------
DASHBOARD_URL=http://136.116.232.100:5050
# Lowest severity that emails: warning | high | critical.
ALERT_MIN_SEVERITY=high
# Re-send an unchanged condition after this many hours. Escalation and new
# conditions bypass it.
ALERT_REPEAT_HOURS=6
BQ_PROJECT=measurement-lab
